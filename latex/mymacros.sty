% ATS: plain words (no ~ / x); altacv: math symbols.
\newcommand{\cvscale}[1]{%
    \ifnum\currentLang=0
        \ifthenelse{\equal{\currentMode}{altacv-ats}}{#1 times}{$\sim$#1$\times$}%
    \else
        \ifthenelse{\equal{\currentMode}{altacv-ats}}{#1 vezes}{$\sim$#1$\times$}%
    \fi
}
\newcommand{\cvapproxpct}[1]{%
    \ifthenelse{\equal{\currentMode}{altacv-ats}}{#1\%}{$\sim$#1\%}%
}
\newcommand{\cvarrow}{%
    \ifnum\currentLang=0
        \ifthenelse{\equal{\currentMode}{altacv-ats}}{ to }{ $\rightarrow$ }%
    \else
        \ifthenelse{\equal{\currentMode}{altacv-ats}}{ para }{ $\rightarrow$ }%
    \fi
}
\newcommand{\cvcpuSpikeRange}[2]{%
    \ifnum\currentLang=0
        \ifthenelse{\equal{\currentMode}{altacv-ats}}{#1\% to #2\%}{$\sim$#1--#2\%}%
    \else
        \ifthenelse{\equal{\currentMode}{altacv-ats}}{#1\% a #2\%}{$\sim$#1--#2\%}%
    \fi
}

\newcommand{\smallObsv}[2]{%
    \ifthenelse{\equal{\currentMode}{altacv}}{%
        #1 {\small(#2)}%
    }{%
        #1, #2%
    }
}

\newcommand{\inlineList}[1]{%
    \begin{enumerate*}[%
        label={},afterlabel={},itemjoin={{, }},after=\unskip{.},%
        leftmargin=0pt,itemindent=0pt,labelindent=0pt,labelsep=0pt]%
        #1%
    \end{enumerate*}%
}

\newcommand{\cvskillblock}[1]{%
    \begin{justify}%
    \noindent\ignorespaces
    #1%
    \end{justify}%
}

\newcommand{\cvproseblock}[1]{%
    \begingroup
    \setlength{\parindent}{0pt}%
    \justifying
    \noindent\ignorespaces
    #1\par
    \endgroup
}

% Tighter gap between skill subsection title and list (cvsubsection ends with \medskip).
\newcommand{\cvskillsubsection}[1]{%
    \cvsubsection{#1}%
    \vspace{\dimexpr-\medskipamount+0.25\baselineskip\relax}%
}

% add \par after each \item
\let\svitem\item
\let\svitemize\itemize
\let\svenditemize\enditemize%
\renewenvironment{itemize}{%
  \def\newitem{\par\svitem}\svitemize%
  \def\item{\let\item\newitem\svitem}%
}{%
  \par\svenditemize%
}

% --- Section / job header pagination (altacv + altacv-ats via hooks in .cls) ---
\RequirePackage{needspace}

\newlength{\cvEventNeedSpaceLen}
\setlength{\cvEventNeedSpaceLen}{9\baselineskip}

\newlength{\cvSectionLeadNeedSpaceLen}
\setlength{\cvSectionLeadNeedSpaceLen}{5\baselineskip}

\newcommand{\cvEventPaginationNeedSpace}{%
  \Needspace{\cvEventNeedSpaceLen}%
}

\newcommand{\cvSectionPaginationNeedSpace}{%
  \dimen0=\cvSectionLeadNeedSpaceLen
  \advance\dimen0 by \cvEventNeedSpaceLen
  \Needspace{\dimen0}%
}

\renewcommand{\cvSectionBeforeHeader}{%
  \cvSectionPaginationNeedSpace
  \begingroup
  \raggedright
}
\renewcommand{\cvSectionAfterHeader}{%
  \endgroup
}

\renewcommand{\cvEventBeforeHeader}{%
  \cvEventPaginationNeedSpace
  \begingroup
  \raggedright
}
\renewcommand{\cvEventAfterHeader}{%
  \endgroup
}

